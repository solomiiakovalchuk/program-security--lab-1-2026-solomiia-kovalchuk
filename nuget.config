<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Власні джерела пакетів для цього рішення.
    <clear /> прибирає фіди, прописані на машині (зокрема робочі,
    які доступні лише з корпоративної мережі й ламають відновлення).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
