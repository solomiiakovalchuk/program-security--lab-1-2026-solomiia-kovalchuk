# ============================================================
# ReportsWpf - .gitignore
# ============================================================

# --- .NET build output ---
[Bb]in/
[Oo]bj/
[Oo]ut/
publish/
artifacts/
*.nupkg
*.snupkg

# --- Visual Studio / VS Code ---
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.cache
_ReSharper*/
*.DotSettings.user

# --- JetBrains Rider ---
.idea/
*.sln.iml

# --- Tests and coverage ---
TestResults/
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml
coverage.cobertura.xml
*.trx

# --- System files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Word/Office lock files (an open .docx) ---
~$*
.~lock.*#

# --- Temporary files ---
*.tmp
*.bak
*.swp

# ============================================================
# SECRETS AND APP DATA - NEVER COMMIT
# The app will keep them in %AppData%\Рапорти, but the files can
# end up in the working folder during debugging or copying.
# ============================================================

# Google OAuth client data (client id / secret)
credentials.json
client_secret*.json

# Cached Google tokens (FileDataStore: token, token-rw)
token/
token-rw/
token*/

# Local SQLite database (+ WAL/SHM) - operational data and personal data
*.db
*.db-*
*.sqlite
*.sqlite3

# User settings of the app (SpreadsheetId, unit details)
settings.json

# User accounts (Identity module) - password hashes, roles
users.json

# Error logs (stack traces, paths, spreadsheet id)
error.log
*.log

# Generated reports and debug data
Рапорти/
