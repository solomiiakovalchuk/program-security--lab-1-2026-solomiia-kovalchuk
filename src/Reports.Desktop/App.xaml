<Application x:Class="Reports.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Reports.Desktop.ViewModels"
             xmlns:views="clr-namespace:Reports.Desktop.Views"
             xmlns:infra="clr-namespace:Reports.Desktop.Infrastructure">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <infra:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- Кожній моделі подання відповідає своя вкладка -->
            <DataTemplate DataType="{x:Type vm:ReportViewModel}">
                <views:ReportView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MissionsViewModel}">
                <views:MissionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DirectoriesViewModel}">
                <views:DirectoriesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:JournalViewModel}">
                <views:JournalView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
                <views:AccountsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuditViewModel}">
                <views:AuditView />
            </DataTemplate>

            <!-- Спільні дрібні стилі поверх стандартних із WPF-UI -->
            <Thickness x:Key="CardSpacing">0,0,0,12</Thickness>

            <!-- Власна картка на Border: коректно розтягується по обох осях,
                 на відміну від ui:Card у цій версії WPF-UI. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background"
                        Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource CardStrokeColorDefaultSolidBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="SectionCaption" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="BodyStrong" />
                <Setter Property="Margin" Value="0,4,0,8" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="ui:TextBlock">
                <Setter Property="FontTypography" Value="Caption" />
                <Setter Property="Foreground"
                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,10,0,4" />
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground"
                        Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,2" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
