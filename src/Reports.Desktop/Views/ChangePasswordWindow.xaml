<ui:FluentWindow x:Class="Reports.Desktop.Views.ChangePasswordWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Reports.Desktop.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d"
                 Title="Зміна пароля"
                 Width="440" Height="500"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 d:DataContext="{d:DesignInstance vm:ChangePasswordViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Зміна пароля" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Grid.Row="1" Margin="32,12,32,24">
            <ui:TextBlock Text="Зміна пароля" FontTypography="Title" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Новий пароль: щонайменше 8 символів, хоча б одна цифра і один розділовий знак чи символ. Він має відрізнятися від поточного." />
            <ui:TextBlock Text="Поточний пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox PasswordChanged="OnCurrentChanged" />
            <ui:TextBlock Text="Новий пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox PasswordChanged="OnNewChanged" />
            <ui:TextBlock Text="Підтвердження нового пароля" Style="{StaticResource FieldLabel}" />
            <PasswordBox PasswordChanged="OnConfirmChanged" />
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,14,0,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" />
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <ui:Button Appearance="Primary" IsDefault="True" Content="Змінити пароль"
                           Command="{Binding SubmitCommand}" />
                <ui:Button Appearance="Transparent" IsCancel="True" Content="Скасувати" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
