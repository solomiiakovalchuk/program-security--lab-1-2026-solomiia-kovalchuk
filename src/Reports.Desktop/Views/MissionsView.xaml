<UserControl x:Class="Reports.Desktop.Views.MissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Reports.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:MissionsViewModel}">

    <DockPanel Margin="16">
        <ui:TextBlock DockPanel.Dock="Top" Text="Відповіді форми"
                      FontTypography="Title" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                       Content="Синхронізувати" Command="{Binding SyncCommand}" />
            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowUpload24}"
                       Content="Вивантажити в таблицю" Margin="6,0,0,0"
                       Command="{Binding PublishCommand}" />
            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}"
                       Content="Оновити" Margin="6,0,0,0" Command="{Binding ReloadCommand}" />
            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Prohibited24}"
                       Content="Скасувати / повернути" Margin="6,0,0,0"
                       Command="{Binding CancelCommand}" />
        </StackPanel>

        <ui:InfoBar DockPanel.Dock="Bottom" IsOpen="True" IsClosable="False"
                    Severity="Informational" Margin="0,12,0,0"
                    Message="{Binding Summary}" />

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Width="95"
                                        Binding="{Binding Date, StringFormat=dd.MM.yyyy}" />
                    <DataGridTextColumn Header="Оператор" Width="190" Binding="{Binding Operator}" />
                    <DataGridTextColumn Header="Нас. пункт" Width="120" Binding="{Binding Settlement}" />
                    <DataGridTextColumn Header="БпЛА" Width="120" Binding="{Binding Uav}" />
                    <DataGridTextColumn Header="К-сть" Width="64" Binding="{Binding UavCount}" />
                    <DataGridTextColumn Header="Ціль" Width="160" Binding="{Binding Targets}" />
                    <DataGridTextColumn Header="Боєприпаси" Width="*" Binding="{Binding Munitions}" />
                    <DataGridTextColumn Header="Статус" Width="130" Binding="{Binding Status}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
