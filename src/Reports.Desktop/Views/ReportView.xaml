<UserControl x:Class="Reports.Desktop.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Reports.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:ReportViewModel}">

    <DockPanel Margin="20,16,20,16" HorizontalAlignment="Stretch" LastChildFill="True">
        <ui:TextBlock DockPanel.Dock="Top" Text="Формування рапорту"
                      FontTypography="Title" Margin="0,0,0,14" />

        <!-- Ліва колонка: параметри -->
        <ScrollViewer DockPanel.Dock="Left" Width="430"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,10,0">
            <StackPanel>

                <Border Style="{StaticResource Card}" Margin="{StaticResource CardSpacing}">
                    <StackPanel>
                        <ui:TextBlock Text="Період" Style="{StaticResource SectionCaption}" />

                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Content="{Binding Title}" Appearance="Secondary"
                                               Margin="0,0,6,6" Padding="12,6"
                                               CommandParameter="{Binding}"
                                               Command="{Binding DataContext.ApplyPresetCommand,
                                                         RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:TextBlock Text="З дати" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding From}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ui:TextBlock Text="По дату" Style="{StaticResource FieldLabel}" />
                                <DatePicker SelectedDate="{Binding To}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="{StaticResource CardSpacing}">
                    <StackPanel>
                        <ui:TextBlock Text="Підпис і фільтри" Style="{StaticResource SectionCaption}" />

                        <ui:TextBlock Text="Від кого рапорт (підписант)" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Signers}" SelectedItem="{Binding Signer}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Style="{StaticResource Hint}"
                                     Text="Визначає посаду, звання та ПІБ у підписі. Береться з довідника «Люди»." />

                        <ui:TextBlock Text="Оператор — фільтр даних" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding OperatorFilter}"
                                  HorizontalAlignment="Stretch" />

                        <ui:TextBlock Text="Населений пункт — фільтр даних" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Settlements}" SelectedItem="{Binding SettlementFilter}"
                                  HorizontalAlignment="Stretch" />

                        <ui:TextBlock Text="Бойовий наказ" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding Order, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" />
                    </StackPanel>
                </Border>

                <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,4,0,0"
                           Icon="{ui:SymbolIcon DocumentText24}"
                           Content="Створити документ" Command="{Binding GenerateCommand}" />
                <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                           Icon="{ui:SymbolIcon Eye24}"
                           Content="Переглянути текст" Command="{Binding PreviewCommand}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Open24}"
                               Content="Відкрити файл" Command="{Binding OpenFileCommand}" />
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon FolderOpen24}"
                               Content="Тека" Margin="6,0,0,0"
                               Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Права колонка: попередній перегляд -->
        <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="0">
            <DockPanel>
                <ui:TextBlock DockPanel.Dock="Top" Text="Попередній перегляд тексту"
                              Style="{StaticResource SectionCaption}" Margin="16,14,16,8" />
                <Border Margin="16,0,16,16" CornerRadius="6"
                        Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                        <TextBlock Text="{Binding PreviewText, Mode=OneWay}"
                                   TextWrapping="Wrap" LineHeight="26"
                                   FontFamily="Times New Roman" FontSize="16" />
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
