<UserControl x:Class="Reports.Desktop.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Reports.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:AccountsViewModel}">

    <DockPanel Margin="16">
        <ui:TextBlock DockPanel.Dock="Top" Text="Облікові записи"
                      FontTypography="Title" Margin="0,0,0,12" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" />

        <!-- Створення -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <ui:TextBlock Text="Новий обліковий запис" Style="{StaticResource SectionCaption}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <ui:TextBlock Text="Логін" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding NewLogin, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <ui:TextBlock Text="Початковий пароль" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="NewPasswordBox" PasswordChanged="OnNewPasswordChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <ui:TextBlock Text="Роль" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding NewRole}" />
                    </StackPanel>
                    <ui:Button Grid.Column="6" VerticalAlignment="Bottom" Appearance="Primary"
                               Icon="{ui:SymbolIcon PersonAdd24}" Content="Створити"
                               Command="{Binding CreateCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Користувач має змінити початковий пароль при першому вході." />
            </StackPanel>
        </Border>

        <!-- Дії над вибраним записом -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <ui:TextBlock Text="Вибраний обліковий запис" Style="{StaticResource SectionCaption}" />
                <WrapPanel>
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon LockClosed24}"
                               Content="Заблокувати" Command="{Binding BlockCommand}" Margin="0,0,6,6" />
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon LockOpen24}"
                               Content="Розблокувати" Command="{Binding UnblockCommand}" Margin="0,0,6,6" />
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Delete24}"
                               Content="Видалити" Command="{Binding DeleteCommand}" Margin="0,0,18,6" />
                    <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedRole}" Width="160" Margin="0,0,6,6" />
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Person24}"
                               Content="Призначити роль" Command="{Binding ChangeRoleCommand}"
                               Margin="0,0,18,6" />
                    <PasswordBox x:Name="TemporaryPasswordBox" Width="190" Margin="0,0,6,6"
                                 PasswordChanged="OnTemporaryPasswordChanged" />
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon KeyReset24}"
                               Content="Скинути пароль" Command="{Binding ResetPasswordCommand}"
                               Margin="0,0,0,6" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Скидання пароля: введіть тимчасовий пароль; користувач змінить його при наступному вході." />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Логін" Width="170" Binding="{Binding Login}" />
                    <DataGridTextColumn Header="Роль" Width="170" Binding="{Binding RoleText}" />
                    <DataGridTextColumn Header="Заблоковано" Width="110" Binding="{Binding BlockedText}" />
                    <DataGridTextColumn Header="Змінити пароль" Width="130" Binding="{Binding MustChangeText}" />
                    <DataGridTextColumn Header="Тимчасово заблоковано до" Width="*" Binding="{Binding LockedText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
