<UserControl x:Class="Reports.Desktop.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Reports.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:AuditViewModel}">

    <DockPanel Margin="16">
        <ui:TextBlock DockPanel.Dock="Top" Text="Журнал аудиту"
                      FontTypography="Title" Margin="0,0,0,12" />

        <!-- SEC-13: попередження про порушений ланцюг хешів або нейтральна примітка -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="14,10" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                AutomationProperties.AutomationId="ChainBanner"
                Visibility="{Binding ChainBroken, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Журнал могли змінити" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding ChainText}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"
                   Text="{Binding ChainText}"
                   Visibility="{Binding ChainIntact, Converter={StaticResource BoolToVis}}" />

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Visibility="{Binding Error, Converter={StaticResource EmptyToCollapsed}}" />

        <!-- Фільтри -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Margin="0,0,10,0" Width="150">
                <ui:TextBlock Text="Користувач" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding ActorLogin, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0" Width="210">
                <ui:TextBlock Text="Дія" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0" Width="140">
                <ui:TextBlock Text="Період з" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding FromDate}" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0" Width="140">
                <ui:TextBlock Text="по" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding ToDate}" />
            </StackPanel>
            <ui:Button VerticalAlignment="Bottom" Appearance="Primary" Icon="{ui:SymbolIcon Filter24}"
                       Content="Застосувати" Command="{Binding ApplyFiltersCommand}" />
        </WrapPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowSync24}"
                       Content="Оновити" Command="{Binding ReloadCommand}" Margin="0,0,6,0" />
            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon DocumentTable24}"
                       Content="Експорт у CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,6,0" />
            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon DocumentText24}"
                       Content="Експорт у JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,6,0" />
            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon DeleteDismiss24}"
                       Content="Очистити старі записи" Command="{Binding RetentionCommand}" />
        </WrapPanel>

        <!-- Сторінки -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="Далі ›"
                       Command="{Binding NextCommand}" />
            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="‹ Назад"
                       Command="{Binding PreviousCommand}" />
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Час" Width="140" Binding="{Binding Time}" />
                    <DataGridTextColumn Header="Користувач" Width="110" Binding="{Binding Actor}" />
                    <DataGridTextColumn Header="Дія" Width="170" Binding="{Binding Action}" />
                    <DataGridTextColumn Header="Обʼєкт" Width="140" Binding="{Binding Target}" />
                    <DataGridTextColumn Header="Результат" Width="90" Binding="{Binding Outcome}" />
                    <DataGridTextColumn Header="Подробиці" Width="*" Binding="{Binding Details}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
