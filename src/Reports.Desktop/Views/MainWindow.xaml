<ui:FluentWindow x:Class="Reports.Desktop.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Reports.Desktop.ViewModels"
                 Title="Рапорти БпЛА"
                 Width="1240" Height="800"
                 MinWidth="920" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 SizeToContent="Manual"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 mc:Ignorable="d"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовкова смуга з піктограмою й діями -->
        <ui:TitleBar Grid.Row="0" Title="Рапорти БпЛА" Padding="14,8">
            <ui:TitleBar.Header>
                <ui:SymbolIcon Symbol="Album24" FontSize="16" Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Бічна навігація -->
            <Border Grid.Column="0" Padding="8,0,8,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,0">
                        <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <ui:TextBlock Text="Користувач" FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:TextBlock Text="{Binding UserLabel}" FontTypography="BodyStrong"
                                              TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Content="Синхронізувати"
                                   Command="{Binding SyncCommand}" />
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left" Margin="0,4,0,0"
                                   Icon="{ui:SymbolIcon WeatherMoon24}"
                                   Content="Тема"
                                   Command="{Binding ToggleThemeCommand}" />
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left" Margin="0,2,0,0"
                                   Icon="{ui:SymbolIcon Key24}"
                                   Content="Змінити пароль"
                                   Command="{Binding ChangePasswordCommand}" />
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left" Margin="0,2,0,0"
                                   Icon="{ui:SymbolIcon SignOut24}"
                                   Content="Вийти"
                                   Command="{Binding LogoutCommand}" />
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Left" Margin="0,2,0,0"
                                   Icon="{ui:SymbolIcon Info24}"
                                   Content="Про програму"
                                   Command="{Binding AboutCommand}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             IsSynchronizedWithCurrentItem="True"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" CornerRadius="6"
                                                    Padding="12,9"
                                                    Background="Transparent">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" />
                                                    <ui:TextBlock Text="{Binding Title}"
                                                                  Margin="12,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  FontTypography="Body" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Вміст обраної вкладки -->
            <Border Style="{StaticResource Card}" Grid.Column="1" Margin="4,0,12,12" Padding="0">
                <DockPanel>
                    <ui:InfoBar DockPanel.Dock="Bottom"
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Informational"
                                Margin="16,0,16,16"
                                Message="{Binding Status}" />

                    <ContentControl Content="{Binding Selected.Content}" Margin="4"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
